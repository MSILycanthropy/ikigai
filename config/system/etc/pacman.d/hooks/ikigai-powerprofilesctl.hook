[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/bin/powerprofilesctl

[Action]
Description = Pinning powerprofilesctl to the system python (Ikigai)...
When = PostTransaction
Exec = /usr/bin/sed -i 1s|^#!/usr/bin/env[[:space:]]python3$|#!/usr/bin/python3| /usr/bin/powerprofilesctl
