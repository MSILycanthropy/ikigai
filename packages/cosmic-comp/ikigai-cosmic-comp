#!/usr/bin/env bash
# Rebuild cosmic-comp from the installed package's own release tag, with Ikigai's patches,
# and install the binary over the stock copy. Runs as root: from install/cosmic-comp.sh at
# install time and from a pacman hook after every cosmic-comp upgrade (which puts the stock
# binary back). The running compositor keeps its old binary; the next login gets the new one.
set -euo pipefail

PATCHES=${IKIGAI_COSMIC_COMP_PATCHES:-/usr/local/share/ikigai/cosmic-comp}
STATE=/var/lib/ikigai/cosmic-comp
CACHE=/var/cache/ikigai/cosmic-comp
BIN=/usr/bin/cosmic-comp

die() { echo "ikigai-cosmic-comp: $*" >&2; exit 1; }
# The build is silent by default: the pacman hook runs inside a transaction. On failure the
# log's tail is printed. install/cosmic-comp.sh passes --progress to show cargo's lines.
progress=${1:-}
run() {
  if [ "$progress" = --progress ]; then "$@"
  else "$@" >>"$work/build.log" 2>&1 || { tail -n 30 "$work/build.log" >&2; return 1; }
  fi
}

[ "$(id -u)" -eq 0 ] || die "run as root"
ls "$PATCHES"/*.patch >/dev/null 2>&1 || die "no patches in $PATCHES"

package=$(pacman -Q cosmic-comp | cut -d' ' -f2)   # 1:1.7.0-1
ver=${package#*:}; ver=${ver%-*}                   # 1.7.0
[ -x "$BIN" ] || die "$BIN missing; is cosmic-comp installed?"

if [ -r "$STATE" ] && [ "$(cat "$STATE")" = "$package $(sha256sum < "$BIN")" ]; then
  echo "cosmic-comp $package already patched"
  exit 0
fi

# No pacman calls here: the hook runs inside a pacman transaction. install/packages.sh installs these.
pacman -Q rust lld git >/dev/null 2>&1 || die "rust, lld and git must be installed"

work="$CACHE/$ver"
mkdir -p "$work" && cd "$work"
: > build.log
# The same tag Arch's PKGBUILD builds. The crate cache and target dir persist across versions,
# so a pkgrel bump or a patch change is an incremental build.
rm -rf src
run git clone -q --depth 1 --branch "epoch-$ver" https://github.com/pop-os/cosmic-comp.git src

for p in "$PATCHES"/*.patch; do
  patch -d src -p1 --forward < "$p" \
    || die "$(basename "$p") no longer applies to cosmic-comp $package. The stock binary stays (middle-click paste is back); see packages/cosmic-comp/README.md"
done

# Mirror Arch's PKGBUILD: thin LTO, lld, makepkg's Rust flags, no debug info.
sed 's/lto = "fat"/lto = "thin"/' -i src/Cargo.toml
# shellcheck disable=SC1091
[ -r /etc/makepkg.conf.d/rust.conf ] && source /etc/makepkg.conf.d/rust.conf
export RUSTFLAGS="${RUSTFLAGS:-} -C link-arg=-fuse-ld=lld"
export CARGO_HOME=$CACHE/cargo CARGO_TARGET_DIR=$CACHE/target
(cd src && run cargo fetch --locked && run cargo build --frozen --release)

built="$CACHE/target/release/cosmic-comp"
[ -f "$built" ] || die "build produced no $built"
strip --strip-all "$built"
install -m755 "$built" "$BIN.new" && mv -f "$BIN.new" "$BIN"   # rename: the running compositor keeps the old mapping

mkdir -p "$(dirname "$STATE")"
echo "$package $(sha256sum < "$BIN")" > "$STATE"
rm -rf src
echo "patched cosmic-comp installed for cosmic-comp $package"
