#!/usr/bin/env bash
# Rebuild Qt's Wayland client library from the installed qt6-base's own source, with
# Ikigai's unmap-before-role-destroy patch, and install it over the stock copy.
# Runs as root: from install/qt.sh at install time and from a pacman hook after every
# qt6-base upgrade (which puts the stock library back).
set -euo pipefail

PATCH=${IKIGAI_QT_PATCH:-/usr/local/share/ikigai/qt6-base/wayland-unmap-before-role-destroy.patch}
STATE=/var/lib/ikigai/qt-wayland
CACHE=/var/cache/ikigai/qt
LIB=/usr/lib/libQt6WaylandClient.so

die() { echo "ikigai-qt-wayland: $*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "run as root"
[ -r "$PATCH" ] || die "patch not found: $PATCH"

package=$(pacman -Q qt6-base | cut -d' ' -f2)   # 6.11.2-3
ver=${package%-*}                               # 6.11.2
lib="$LIB.$ver"
[ -e "$lib" ] || die "$lib missing; is qt6-base installed?"

if [ -r "$STATE" ] && [ "$(cat "$STATE")" = "$package $(sha256sum < "$lib")" ]; then
  echo "qt6-base $package already patched"
  exit 0
fi

# No pacman calls here: the hook runs inside a pacman transaction. install/packages.sh installs these.
pacman -Q cmake ninja ccache vulkan-headers >/dev/null 2>&1 || die "cmake, ninja, ccache and vulkan-headers must be installed"

tarball="qtbase-everywhere-src-$ver.tar.xz"
base="https://download.qt.io/official_releases/qt/${ver%.*}/$ver/submodules"
work="$CACHE/$ver"
mkdir -p "$work" && cd "$work"
[ -f "$tarball" ] || curl -fsSL -o "$tarball" "$base/$tarball"
curl -fsSL "$base/$tarball.sha256" | sha256sum -c --quiet -
rm -rf src build && mkdir src && tar -xf "$tarball" -C src --strip-components=1

patch -d src -p1 --forward < "$PATCH" \
  || die "patch no longer applies to qt6-base $package. Layer-shell clients (the Ikigai shell, Vicinae) will break when they hide a window; see packages/qt6-base/README.md"

# Mirror Arch's PKGBUILD except LTO (build time) and debug info; the ABI is unaffected.
# shellcheck disable=SC1091
source /etc/makepkg.conf
export CFLAGS CXXFLAGS LDFLAGS
# A pkgrel bump rebuilds identical sources with identical flags: ccache turns that into a
# minute. Precompiled headers are off because ccache cannot cache compilations that use them.
export CCACHE_DIR=$CACHE/ccache
cmake -B build -S src -G Ninja \
  -DCMAKE_C_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache -DBUILD_WITH_PCH=OFF \
  -DCMAKE_INSTALL_PREFIX=/usr \
  -DCMAKE_BUILD_TYPE=Release \
  -DINSTALL_BINDIR=lib/qt6/bin \
  -DINSTALL_PUBLICBINDIR=bin \
  -DINSTALL_LIBEXECDIR=lib/qt6 \
  -DINSTALL_DOCDIR=share/doc/qt6 \
  -DINSTALL_ARCHDATADIR=lib/qt6 \
  -DINSTALL_DATADIR=share/qt6 \
  -DINSTALL_INCLUDEDIR=include/qt6 \
  -DINSTALL_MKSPECSDIR=lib/qt6/mkspecs \
  -DINSTALL_EXAMPLESDIR=share/doc/qt6/examples \
  -DFEATURE_journald=ON \
  -DFEATURE_libproxy=ON \
  -DFEATURE_openssl_linked=ON \
  -DFEATURE_system_sqlite=ON \
  -DFEATURE_system_xcb_xinput=ON \
  -DFEATURE_no_direct_extern_access=ON \
  -DFEATURE_mimetype_database=OFF \
  -DFEATURE_openssl_hash=ON \
  -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=OFF \
  -DQT_BUILD_TESTS=OFF -DQT_BUILD_EXAMPLES=OFF \
  -DCMAKE_MESSAGE_LOG_LEVEL=WARNING >/dev/null

# One job per ~1.2 GB of RAM: QtGui translation units are large.
mem_jobs=$(( $(awk '/MemTotal/ { print $2 }' /proc/meminfo) / 1200000 ))
jobs=$(( mem_jobs < $(nproc) ? mem_jobs : $(nproc) ))
ninja -C build -j "$(( jobs > 0 ? jobs : 1 ))" WaylandClient >/dev/null

built="build/lib/libQt6WaylandClient.so.$ver"
[ -f "$built" ] || die "build produced no $built"
strip --strip-unneeded "$built"
install -m755 "$built" "$lib.new" && mv -f "$lib.new" "$lib"   # rename: running clients keep the old mapping

mkdir -p "$(dirname "$STATE")"
echo "$package $(sha256sum < "$lib")" > "$STATE"
rm -rf src build
echo "patched Qt Wayland client installed for qt6-base $package"
