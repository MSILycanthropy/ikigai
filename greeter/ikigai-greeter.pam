#%PAM-1.0
# greetd's PAM service for the Ikigai greeter: Arch's login stack, plus gnome-keyring so
# the password that logs you in also unlocks the login keyring (Zen, Zed, gh, the Chromium
# apps and Vicinae keep their secrets there; without this each asks for a keyring password
# or falls back to plaintext). Optional on both lines: a missing keyring never blocks login.

auth       requisite    pam_nologin.so
auth       include      system-local-login
auth       optional     pam_gnome_keyring.so
account    include      system-local-login
password   include      system-local-login
session    include      system-local-login
session    optional     pam_gnome_keyring.so auto_start
