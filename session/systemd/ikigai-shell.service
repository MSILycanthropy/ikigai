[Unit]
Description=Ikigai shell (Quickshell)
PartOf=ikigai-session.target
After=graphical-session-pre.target

[Service]
Environment=QT_QPA_PLATFORM=wayland QT_QPA_PLATFORMTHEME= QS_DISABLE_FILE_WATCHER=1 QML_IMPORT_PATH=/usr/local/lib/qt6/qml
ExecStart=/usr/bin/qs -p /usr/local/share/ikigai/shell/shell.qml
Restart=on-failure
RestartSec=1
