#!/usr/bin/env bash
# Ikigai's firewall, as root: deny incoming, allow outgoing, keep ssh when sshd is enabled,
# and let ufw-docker close the hole Docker's own iptables rules punch through ufw for
# published ports. Containers may still reach the host's DNS. Stamps itself done so the
# first-boot unit (firewall/) runs it once.
set -euo pipefail

ufw default deny incoming
ufw default allow outgoing
if systemctl is-enabled -q sshd 2>/dev/null; then
  ufw allow ssh
fi
ufw allow in proto udp from 172.16.0.0/12 to 172.17.0.1 port 53 comment 'docker dns'
ufw allow in proto udp from 192.168.0.0/16 to 172.17.0.1 port 53 comment 'docker dns'

ufw --force enable
ufw-docker install
systemctl enable --now ufw
ufw reload
ufw status verbose | head -5

install -d /var/lib/ikigai
touch /var/lib/ikigai/firewall-applied
