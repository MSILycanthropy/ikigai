#!/usr/bin/env bash
# Apply an Ikigai theme: everything a theme dir provides goes where its app reads it.
# Colours come from themes/<name>/palette.json via scripts/theme-build.py; app configs
# (seeded by the installer) name the theme, so a second theme also needs those seeds.
set -euo pipefail

IKIGAI_PATH="${IKIGAI_PATH:-$HOME/.local/share/ikigai}"
THEME="${1:-}"
T="$IKIGAI_PATH/themes/$THEME"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/ikigai"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}"

if [ -z "$THEME" ] || [ ! -d "$T" ]; then
  echo "usage: ikigai-theme-set <theme>" >&2
  echo "available: $(ls "$IKIGAI_PATH/themes" | tr '\n' ' ')" >&2
  exit 2
fi

BACKUP="$STATE/backup/$(date +%Y%m%d-%H%M%S)"
backup() { [ -e "$1" ] || return 0; mkdir -p "$BACKUP"; mv "$1" "$BACKUP/"; echo "backed up $1 → $BACKUP/"; }
put() { install -Dm644 "$T/$1" "$2"; }

put shell.json           "$STATE/shell-theme.json"
put ghostty/$THEME       "$HOME/.config/ghostty/themes/$THEME"
put btop/$THEME.theme    "$HOME/.config/btop/themes/$THEME.theme"
put vicinae/$THEME.toml  "$DATA/vicinae/themes/$THEME.toml"
put gtk/gtk.css          "$HOME/.config/gtk-3.0/gtk.css"
put gtk/gtk.css          "$HOME/.config/gtk-4.0/gtk.css"

sudo install -Dm644 "$T/wallpaper.jpg" "/usr/local/share/backgrounds/ikigai/$THEME.jpg"
(cd "$T/cosmic" && find . -type f -not -name '*.ron' -not -name README) | while read -r f; do
  sudo install -Dm644 "$T/cosmic/$f" "/usr/local/share/cosmic/$f"
done

# A user-layer theme (written by Settings on first login) would shadow ours.
backup "$HOME/.config/cosmic/com.system76.CosmicTheme.Dark"
backup "$HOME/.config/cosmic/com.system76.CosmicTheme.Dark.Builder"

echo "theme: $THEME"
